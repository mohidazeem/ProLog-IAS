{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InventoryApi": {
    "ApiKeyHeaderName": "X-Api-Key",
    "Resilience": {
      "TotalRequestTimeout": { "Timeout": "00:00:30" },
      "AttemptTimeout": { "Timeout": "00:00:10" },
      "Retry": {
        "MaxRetryAttempts": 3,
        "BackoffType": "Exponential",
        "UseJitter": true,
        "Delay": "00:00:01"
      }
    }
  },
  "InventoryCollection": {
    "PageSize": 25,
    "MaxPageAttempts": 3
  }
}
